function dishKey(name){
  const n=name.toLowerCase();
  if(/omelete|ovo|crepioca|beiju|tapioca/.test(n)) return 'ovos';
  if(/panqueca/.test(n)) return 'panqueca';
  if(/quiche|muffin|pão de queijo|escondidinho|lasanha|feijoada|torta de frango/.test(n)) return 'tortasalgada';
  if(/bolo|brownie|cheesecake|pavê|torta de lim|torta de maçã/.test(n)) return 'bolo';
  if(/cookie|trufa|brigadeiro|doce de leite|bombom|pudim|mousse|gelatina|beijinho|barrinha|sorvete/.test(n)) return 'cookie';
  if(/sopa/.test(n)) return 'sopa';
  if(/salada/.test(n)) return 'salada';
  if(/sanduíche|wrap|rap10/.test(n)) return 'sanduiche';
  if(/vitamina|shake|smoothie/.test(n)) return 'vitamina';
  if(/iogurte/.test(n)) return 'iogurte';
  if(/peixe|salmão|tilápia|camarão/.test(n)) return 'peixe';
  if(/carne|bife|almôndega|bolinho|croquete|quibe|hambúrguer|patinho|suíno/.test(n)) return 'carne';
  if(/frango|espetinho|xadrez|curry/.test(n)) return 'frango';
  return 'default';
}
function recipeCard(r,showTag){
  const stepsHtml = r.steps ? `<ol class="steps">${r.steps.map(s=>`<li>${s}</li>`).join('')}</ol>` : '';
  return `<div class="card"><div class="dish-thumb">${DISH_SVG[dishKey(r.name)]}</div><h3>${r.name}</h3>
    <div class="meta"><span>⏱ ${r.time} min</span><span><b>${r.protein}g</b> proteína</span><span>${r.kcal} kcal</span></div>
    ${showTag?`<span class="tag">${r.cat}</span>`:''}
    <div class="ing">${r.ing.join(' · ')}</div>
    ${stepsHtml}</div>`;
}
function renderRecipes(){
  let list=RECIPES.filter(r=>(state.cat==="Todos"||r.cat===state.cat)&&r.protein>=state.minProt);
  document.getElementById('recipeList').innerHTML = list.length? list.map(r=>recipeCard(r,true)).join('') : '<div class="empty">Nenhuma receita nesse filtro ainda.</div>';
}

// cardapio view
function renderGoalChips(){
  const wrap=document.getElementById('goalChips');
  wrap.innerHTML=Object.entries(GOALS).map(([k,v])=>`<div class="chip${state.goal===k?' active':''}" data-g="${k}">${v.label}</div>`).join('');
  wrap.querySelectorAll('.chip').forEach(c=>c.onclick=()=>{state.goal=c.dataset.g;renderGoalChips();renderDayBtns();renderMenu();});
}
function renderDayBtns(){
  const days=Object.keys(GOALS[state.goal].days);
  if(!days.includes(state.day)) state.day=days[0];
  document.getElementById('dayBtns').innerHTML=days.map(d=>`<button class="${d===state.day?'active':''}" data-d="${d}">${d}</button>`).join('');
  document.querySelectorAll('#dayBtns button').forEach(b=>b.onclick=()=>{state.day=b.dataset.d;renderDayBtns();renderMenu();});
}
function renderMenu(){
  const ids=GOALS[state.goal].days[state.day]||[];
  document.getElementById('menuList').innerHTML = ids.map(id=>{const r=byId(id);
    return `<div class="menuitem"><span>${r.name}</span><span><b>${r.protein}g</b></span></div>`;}).join('') || '<div class="empty">Sem cardápio pra esse dia.</div>';
}

// geladeira view
document.getElementById('fridgeInput').oninput=e=>{
  const items=e.target.value.toLowerCase().split(',').map(s=>s.trim()).filter(Boolean);
  const wrap=document.getElementById('fridgeResults');
  if(!items.length){wrap.innerHTML='';return;}
  const matches=RECIPES.filter(r=>r.ing.some(i=>items.some(it=>i.toLowerCase().includes(it))));
  wrap.innerHTML = matches.length? matches.map(r=>recipeCard(r,true)).join('') : '<div class="empty">Nenhuma receita bate com esses ingredientes ainda.</div>';
};

// contador view
function renderGate(){
  document.getElementById('gateList').innerHTML = RECIPES.map(r=>{
    const on=state.eaten.includes(r.id);
    return `<div class="gate"><span>${r.name} <span style="color:var(--muted)">· ${r.protein}g</span></span><button data-id="${r.id}" class="${on?'on':''}">${on?'✓ Comi':'Marcar'}</button></div>`;
  }).join('');
  document.querySelectorAll('#gateList button').forEach(b=>b.onclick=()=>{
    const id=+b.dataset.id;
    const i=state.eaten.indexOf(id);
    if(i>-1) state.eaten.splice(i,1); else state.eaten.push(id);
    try{localStorage.setItem('proteico_eaten_'+today(), JSON.stringify(state.eaten));}catch(e){}
    renderGate();renderCounter();
  });
}
function renderCounter(){
  const total=state.eaten.reduce((s,id)=>s+byId(id).protein,0);
  const goal=120;
  document.getElementById('counterNum').textContent=total+'g';
  document.getElementById('counterFill').style.width=Math.min(100,total/goal*100)+'%';
}

