function renderChips(){
  const wrap=document.getElementById('catChips');
  wrap.innerHTML=CATS.map(c=>`<div class="chip${c===state.cat?' active':''}" data-c="${c}">${c}</div>`).join('');
  wrap.querySelectorAll('.chip').forEach(c=>c.onclick=()=>{state.cat=c.dataset.c;renderChips();renderRecipes();});
}
