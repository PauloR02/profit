function renderWLocalChips(){
  const wrap=document.getElementById('wLocalChips');
  wrap.innerHTML=['casa','academia'].map(l=>`<div class="chip${state.wLocal===l?' active':''}" data-l="${l}">${l==='casa'?'Em Casa':'Academia'}</div>`).join('');
  wrap.querySelectorAll('.chip').forEach(c=>c.onclick=()=>{state.wLocal=c.dataset.l;renderWLocalChips();renderWorkouts();});
}
function renderWLevelChips(){
  const wrap=document.getElementById('wLevelChips');
  const levels=[['iniciante','Iniciante'],['intermediario','Intermediário'],['avancado','Avançado']];
  wrap.innerHTML=levels.map(([k,label])=>`<div class="chip${state.wLevel===k?' active':''}" data-k="${k}">${label}</div>`).join('');
  wrap.querySelectorAll('.chip').forEach(c=>c.onclick=()=>{state.wLevel=c.dataset.k;renderWLevelChips();renderWorkouts();});
}
function renderWorkouts(){
  const days=(WORKOUTS[state.wLocal]&&WORKOUTS[state.wLocal][state.wLevel])||[];
  document.getElementById('workoutList').innerHTML = days.length ? days.map(d=>`
    <div class="card"><h3>${d.day} — ${d.title}</h3>
      <div class="meta"><span>⏱ ${d.duration}</span></div>
      ${d.exercises.map(ex=>`<details class="exdrop"><summary>${ex.name} <b>${ex.sets}</b></summary><p>${ex.desc}</p></details>`).join('')}
    </div>`).join('') : '<div class="empty">Treinos desse nível chegando em breve.</div>';
}

renderChips();renderRecipes();
renderGoalChips();renderDayBtns();renderMenu();
renderGate();renderCounter();
renderWLocalChips();renderWLevelChips();renderWorkouts();

// onboarding install modal
function setOsTab(os){
  document.getElementById('tabIos').classList.toggle('active',os==='ios');
  document.getElementById('tabAndroid').classList.toggle('active',os==='android');
  document.getElementById('stepsIos').classList.toggle('active',os==='ios');
  document.getElementById('stepsAndroid').classList.toggle('active',os==='android');
}
const isIos = /iphone|ipad|ipod/i.test(navigator.userAgent);
setOsTab(isIos ? 'ios' : 'android');
document.getElementById('tabIos').onclick=()=>setOsTab('ios');
document.getElementById('tabAndroid').onclick=()=>setOsTab('android');

const onboardModal = document.getElementById('onboardModal');
try{
  if(localStorage.getItem('profit_onboarded')==='1') onboardModal.classList.add('hidden');
}catch(e){}
document.getElementById('closeOnboard').onclick=()=>{
  onboardModal.classList.add('hidden');
  try{localStorage.setItem('profit_onboarded','1');}catch(e){}
};
document.getElementById('reopenInstall').onclick=()=>{
  onboardModal.classList.remove('hidden');
};
</script>
